# --- OS / editor ---
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# --- Node / Astro ---
node_modules/
apps/web/dist/
apps/web/.astro/
apps/web/.wrangler/
.pnpm-store/
*.tsbuildinfo
.lighthouseci/
apps/web/lhci-report/
apps/web/playwright-report/
apps/web/test-results/
apps/web/coverage/

# --- Go ---
apps/notebook-api/bin/
apps/notebook-api/coverage.out
apps/notebook-api/*.test

# --- Terraform ---
**/.terraform/
**/.terraform.lock.hcl.bak
**/terraform.tfstate
**/terraform.tfstate.backup
# Plaintext variable files are ignored; SOPS-encrypted (*.enc.tfvars[.json])
# and example files are tracked (see .sops.yaml, docs/runbooks/secrets.md).
**/*.tfvars
**/*.tfvars.json
!**/*.example.tfvars
!**/*.example.tfvars.json
!**/*.enc.tfvars
!**/*.enc.tfvars.json
**/crash.log
**/tfplan
**/tfplan.*

# --- Cluster credentials (never commit) ---
**/kubeconfig
**/kubeconfig.*
**/talosconfig
**/talosconfig.*
**/*.kubeconfig
*.pem
*.key
!**/*.pub

# --- SOPS / age private material ---
**/age.key
**/keys.txt
.sops-age-key

# --- Local env ---
.env
.env.*
!.env.example

# --- Review evidence that is large or generated ---
docs/reviews/evidence/**/*.log
docs/reviews/evidence/**/node_modules/

# OpenPGP: only the public key is ever committed; belt and braces.
*.sec.asc
*secret*.asc
*private*.asc
*.gpg

