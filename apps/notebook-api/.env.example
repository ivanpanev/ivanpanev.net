# Local development. Copy to .env (gitignored).
LISTEN_ADDR=:8080
DATABASE_URL=postgres://notebook:notebook@127.0.0.1:5432/notebook?sslmode=disable
CORS_ORIGINS=http://127.0.0.1:4321,http://localhost:4321
MAX_ITEM_BYTES=20971520
MAX_NOTEBOOK_BYTES=104857600
MAX_ITEMS=50
MIN_TTL=3m
MAX_TTL=5h18m
DEFAULT_TTL=18m
RATE_BURST=20
RATE_PER_SEC=2
LOG_LEVEL=info
