{
  "name": "@ivp/web",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "ivanpanev.net - static site (Astro) deployed to Cloudflare Workers Static Assets",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
