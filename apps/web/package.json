    "astro": "^7.3.2",
    "astro-pagefind": "^2.0.1",
    "openpgp": "^6.3.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "satori": "^0.33.4",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
