# Response headers for Cloudflare Workers Static Assets.
# The per-page CSP is a <meta> tag emitted by Astro (script/style hashes) and
# is Content-Security-Policy (enforce), not Report-Only. Hashes are unique
# per page, so a single Report-Only header cannot replace the meta tag.
# Directives a meta tag cannot carry (frame-ancestors) live here as enforce.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY

# Hashed build assets are immutable.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
/pagefind/*
  Cache-Control: public, max-age=86400

# WKD clients fetch cross-origin and must not be redirected or blocked.
/.well-known/openpgpkey/*
  Access-Control-Allow-Origin: *
  Cross-Origin-Resource-Policy: cross-origin
  Content-Type: application/octet-stream
  Cache-Control: public, max-age=3600
/.well-known/openpgpkey/policy
  Content-Type: text/plain

# Published key and raw posts are meant to be fetched by tools.
/pgp/*.asc
  Access-Control-Allow-Origin: *
  Cross-Origin-Resource-Policy: cross-origin
  Content-Type: application/pgp-keys
/signatures/*
  Access-Control-Allow-Origin: *
  Cross-Origin-Resource-Policy: cross-origin
  Content-Type: application/pgp-signature
/raw/*
  Access-Control-Allow-Origin: *
  Cross-Origin-Resource-Policy: cross-origin
  Content-Type: text/markdown; charset=utf-8
  X-Robots-Tag: noindex

/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8
/.well-known/security.txt.asc
  Content-Type: application/pgp-signature
  Access-Control-Allow-Origin: *
  Cross-Origin-Resource-Policy: cross-origin
