---
import { SITE } from '@/site';
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-line">
  <div class="mx-auto flex max-w-[var(--wiki-width)] flex-col gap-4 px-4 py-10 text-sm text-fg-muted sm:flex-row sm:items-center sm:justify-between sm:px-6">
    <p class="flex items-center gap-3">
      <span class="hanko" aria-hidden="true">IP</span>
      <span>
        © {SITE.established === year ? year : `${SITE.established}–${year}`} {SITE.author}. Text is{' '}
        <a class="underline hover:text-fg" href="https://creativecommons.org/licenses/by/4.0/" rel="license">CC BY 4.0</a>;
        code samples are MIT unless stated.
      </span>
    </p>
    <nav aria-label="Footer" class="flex flex-wrap gap-x-4 gap-y-1">
      <a class="hover:text-fg" href="/rss.xml">RSS</a>
      <a class="hover:text-fg" href="/pgp">PGP</a>
      <a class="hover:text-fg" href="/verify">Verify</a>
      <a class="hover:text-fg" href="/.well-known/security.txt">security.txt</a>
      <a class="hover:text-fg" href="https://github.com/ivanpanev" rel="me">GitHub</a>
    </nav>
  </div>
</footer>
