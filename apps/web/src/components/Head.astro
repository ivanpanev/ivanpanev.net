---
/**
 * Everything inside <head>. The theme script is inlined before any stylesheet
 * so the first paint already has the right data-theme/data-skin; its SHA-256
 * is registered with Astro's CSP so the strict script-src still permits it.
 */
import { Font } from 'astro:assets';
import { createHash } from 'node:crypto';
import { SITE } from '@/site';
import { buildHeadScript } from '@/lib/theme';
import { canonicalPath, ogImagePath } from '@/lib/urls';
import { getSiteKey } from '@/lib/site-key';

interface Props {
  title: string;
  description?: string;
  /** Absolute or site-relative path to a social image; defaults to the generated OG image for this page. */
  image?: string | undefined;
  type?: 'website' | 'article';
  published?: Date | undefined;
  updated?: Date | undefined;
  noindex?: boolean;
}

const {
  title,
  description = SITE.description,
  image,
  type = 'website',
  published,
  updated,
  noindex = false,
} = Astro.props;

const canonical = new URL(canonicalPath(Astro.url.pathname), Astro.site);
const fullTitle = title === SITE.title ? title : `${title} · ${SITE.title}`;
const ogImage = new URL(image ?? ogImagePath(Astro.url.pathname), Astro.site);
const siteKey = await getSiteKey();
const keyLocal = SITE.email.split('@')[0]!;

const headScript = buildHeadScript();
const headScriptHash = `sha256-${createHash('sha256').update(headScript, 'utf8').digest('base64')}` as const;
Astro.csp?.insertScriptHash(headScriptHash);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{fullTitle}</title>
<script is:inline set:html={headScript} />
<meta name="description" content={description} />
<meta name="author" content={SITE.author} />
<meta name="color-scheme" content="light dark" />
<meta name="theme-color" media="(prefers-color-scheme: light)" content="#f7f5ef" />
<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#121110" />
{noindex && <meta name="robots" content="noindex" />}
<link rel="canonical" href={canonical} />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<link rel="alternate" type="application/rss+xml" title={`${SITE.title} · Blog`} href="/rss.xml" />
<link rel="sitemap" href="/sitemap-index.xml" />
{siteKey && <link rel="pgpkey" type="application/pgp-keys" href={`/pgp/${keyLocal}.asc`} />}
<Font cssVariable="--font-zen-kaku" preload />
<Font cssVariable="--font-zen-mincho" />
<Font cssVariable="--font-jetbrains-mono" />

<meta property="og:site_name" content={SITE.title} />
<meta property="og:type" content={type} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content="en_GB" />
{published && <meta property="article:published_time" content={published.toISOString()} />}
{updated && <meta property="article:modified_time" content={updated.toISOString()} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
