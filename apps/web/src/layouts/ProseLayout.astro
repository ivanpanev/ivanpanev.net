---
/** Blog post layout: title block, meta line, prose body, signature footer. */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { formatDate, isoDate, type Post } from '@/lib/content';
import { readingTime } from '@/lib/reading-time';

interface Props {
  post: Post;
}
const { post } = Astro.props;
const { title, summary, date, updated, tags, signed } = post.data;
const rt = readingTime(post.body);
---

<BaseLayout title={title} description={summary} type="article" published={date} updated={updated}>
  <article class="prose" data-pagefind-body>
    <header class="mb-8 not-prose">
      <p class="text-sm text-fg-muted">
        <time datetime={isoDate(date)}>{formatDate(date)}</time>
        {updated && <>{' '}· updated <time datetime={isoDate(updated)}>{formatDate(updated)}</time></>}
        {' '}· {rt.minutes} min read
      </p>
      <h1 class="mt-2 text-4xl font-bold tracking-tight">{title}</h1>
      <p class="mt-3 text-lg text-fg-muted">{summary}</p>
      {
        tags.length > 0 && (
          <ul class="mt-4 flex flex-wrap gap-2" aria-label="Tags">
            {tags.map((t) => (
              <li>
                <a class="pill hover:underline" href={`/blog/tags/${t}`}>
                  #{t}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </header>
    <slot />
    <footer class="not-prose mt-12 rounded-md border border-line bg-surface p-4 text-sm text-fg-muted">
      {
        signed ? (
          <p>
            This post is signed. <a class="underline" href={`/verify?post=${post.id}`}>Verify the signature</a> against
            the <a class="underline" href="/pgp">published key</a>, or fetch the{' '}
            <a class="underline" href={`/raw/${post.id}.md`}>raw Markdown</a> and{' '}
            <a class="underline" href={`/signatures/${post.id}.md.asc`}>detached signature</a>.
          </p>
        ) : (
          <p>
            Raw Markdown: <a class="underline" href={`/raw/${post.id}.md`}>{post.id}.md</a>. This post carries no
            signature yet.
          </p>
        )
      }
    </footer>
  </article>
</BaseLayout>
