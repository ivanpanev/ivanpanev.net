---
/** Projects wiki: left sidebar (sections + search), article, right table of contents. */
import type { MarkdownHeading } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Sidebar from '@/components/Sidebar.astro';
import TableOfContents from '@/components/TableOfContents.astro';
import { formatDate, isoDate, type Project } from '@/lib/content';

interface Props {
  project: Project;
  headings: MarkdownHeading[];
}
const { project, headings } = Astro.props;
const { title, summary, status, stack, repo, updated } = project.data;
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<BaseLayout title={title} description={summary} wide class="!py-0">
  <div class="grid gap-10 lg:grid-cols-[15rem_minmax(0,1fr)] xl:grid-cols-[15rem_minmax(0,1fr)_13rem]">
    <Sidebar current={project.id} />
    <article class="prose min-w-0 py-10" data-pagefind-body>
      <header class="not-prose mb-8">
        <div class="flex flex-wrap items-center gap-2 text-sm text-fg-muted">
          <span class="pill capitalize" data-pagefind-ignore>{status}</span>
          {updated && <span>updated <time datetime={isoDate(updated)}>{formatDate(updated)}</time></span>}
        </div>
        <h1 class="mt-2 text-4xl font-bold tracking-tight">{title}</h1>
        <p class="mt-3 text-lg text-fg-muted">{summary}</p>
        {
          (stack.length > 0 || repo) && (
            <dl class="kv mt-4 text-sm" data-pagefind-ignore>
              {stack.length > 0 && (
                <>
                  <dt>Stack</dt>
                  <dd class="!font-sans">{stack.join(', ')}</dd>
                </>
              )}
              {repo && (
                <>
                  <dt>Repository</dt>
                  <dd>
                    <a class="underline" href={repo} rel="noopener">{repo.replace(/^https?:\/\//, '')}</a>
                  </dd>
                </>
              )}
            </dl>
          )
        }
      </header>
      <slot />
    </article>
    <TableOfContents headings={toc} />
  </div>
</BaseLayout>
