---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Not found" description="There is nothing at this address." noindex>
  <h1 class="text-3xl font-bold tracking-tight">404</h1>
  <p class="mt-2 text-fg-muted">There is nothing at this address. It may have moved, or never existed.</p>
  <p class="mt-6 flex flex-wrap gap-3 text-sm">
    <a class="btn" href="/">Home</a>
    <a class="btn" href="/blog">Blog</a>
    <a class="btn" href="/projects">Projects</a>
  </p>
</BaseLayout>
