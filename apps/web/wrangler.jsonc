{
  // Static assets only: no Worker script, so there is no code path on the
  // edge to break and requests never leave Cloudflare's asset cache.
  // https://developers.cloudflare.com/workers/static-assets/
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ivanpanev-net",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    // /blog/post.html is served at /blog/post; /blog/post/ redirects to /blog/post.
    "html_handling": "drop-trailing-slash",
    // Serve dist/404.html with a 404 status for unknown paths.
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "ivanpanev.net", "custom_domain": true },
    { "pattern": "www.ivanpanev.net", "custom_domain": true }
  ],
  // Production is only reachable on the custom domains; PR previews get a
  // per-version *.workers.dev URL from `wrangler versions upload`.
  "workers_dev": false,
  "preview_urls": true,
  "observability": { "enabled": false }
}
