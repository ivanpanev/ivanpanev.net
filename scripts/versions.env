# Single source of truth for toolchain versions (M0-R1-F10).
# Read by scripts/check-toolchain.{ps1,sh}, scripts/setup-wsl.sh and
# scripts/setup-windows.ps1. docs/toolchain.md refers here instead of
# repeating numbers.
#
# MIN_<TOOL>  minimum acceptable installed version = oldest upstream-supported
#             release at the time of the last update.
# PIN_<TOOL>  exact version setup-wsl.sh downloads (checksum-verified).
# Cluster-bound tools (kubectl, talosctl) are checked against the cluster
# targets below rather than a fixed minimum.
#
# Format: KEY=VALUE, one per line, '#' comments. No quotes, no spaces.
# Last reviewed: 2026-09-16

# --- cluster targets (tentative until infra/terraform/hetzner pins them in M2;
#     that pin becomes authoritative and this file must be updated to match) ---
KUBERNETES_VERSION=1.35
TALOS_VERSION=1.14

# --- minimums ---
MIN_GIT=2.45
MIN_NODE=22.12
MIN_PNPM=10.0
MIN_GO=1.26
MIN_DOCKER=27.0
MIN_TERRAFORM=1.12
MIN_PACKER=1.12
MIN_HELM=3.18
MIN_KUSTOMIZE=5.6
MIN_KUBECONFORM=0.7
MIN_ARGOCD=3.0
MIN_SOPS=3.10
MIN_AGE=1.1     # Debian/Ubuntu 24.04 package is 1.1.1; upstream ships no checksums so distro packages are used (M0-R2-F01)
MIN_GH=2.70
MIN_COSIGN=3.0
MIN_HCLOUD=1.50

# --- pins for setup-wsl.sh (linux) ---
PIN_NODE=24.21.0
PIN_PNPM=12.4.2
PIN_GO=1.27.1
PIN_TERRAFORM=1.16.2
PIN_PACKER=1.16.0
PIN_HELM=4.3.0
PIN_KUBECTL=1.35.8
PIN_KUSTOMIZE=5.8.1
PIN_KUBECONFORM=0.8.0
PIN_TALOSCTL=1.14.0
PIN_ARGOCD=3.5.3
PIN_SOPS=3.13.3
PIN_GH=2.101.0
PIN_COSIGN=3.1.3
PIN_HCLOUD=1.67.0
